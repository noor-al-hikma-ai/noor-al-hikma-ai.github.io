{
  "name": "noor-al-hikma-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Noor Al Hikma AI \u2014 CaseSpine website, live walkthrough, Studio and RAG sandbox",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "esbuild scripts/test-compiler.ts --bundle --platform=node --format=esm --outfile=.test/test-compiler.mjs --log-level=warning && node .test/test-compiler.mjs .test/out",
    "sample-pdf": "python3 scripts/make-sample-pdf.py public/samples/demo_bank_card_disputes.pdf"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.6",
    "@codemirror/commands": "^6.8.1",
    "@codemirror/language": "^6.11.0",
    "@codemirror/lint": "^6.8.5",
    "@codemirror/search": "^6.5.10",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.8",
    "@fontsource/amiri": "^5.2.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.2.0",
    "@fontsource/inter": "^5.2.0",
    "@fontsource/jetbrains-mono": "^5.2.0",
    "@fontsource/source-serif-4": "^5.2.0",
    "@lezer/highlight": "^1.2.1",
    "d3": "^7.9.0",
    "fflate": "^0.8.2",
    "pdfjs-dist": "4.10.38",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.25.12",
    "typescript": "~5.9.3",
    "vite": "^6.4.5"
  }
}
